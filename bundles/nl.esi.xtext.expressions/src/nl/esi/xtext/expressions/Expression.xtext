grammar nl.esi.xtext.expressions.Expression with nl.esi.xtext.types.Types
/**
 * GRAMMAR AND MODEL STRUCTURE
 * 
 * By default, this grammar generates code from an external Ecore model (Expression.ecore) which defines
 * the abstract syntax tree (AST) structure. The grammar rules define the concrete syntax.
 * 
 * If you modify this xtext grammar:
 *   1. Switch to the "generate expression" line (uncomment it, comment out the "import" line for Expression)
 *   If you have issues in the generation then
 *      1a. Remove all files from /nl.esi.xtext.expressions/model/generated
 *      1b. In ./GenerateExpression.mwe2 comment out this line (around line 61)  referencedResource = "platform:/resource/${projectName}/model/generated/${fileName}.genmodel"
 *   2. Right-click: Run As > Generate Xtext Artifacts (generates new Expression.ecore and Expression.genmodel)
 *   3. Review the generated files in models/generated/
 *   If you had issues in the generation then
 *      3a. In ./GenerateExpression.mwe2 uncomment this line  referencedResource = "platform:/resource/${projectName}/model/generated/${fileName}.genmodel"
 *   4. Switch back to the "import" line (comment out "generate", uncomment "import")
 *   5. Right-click: Run As > Generate Xtext Artifacts again (uses new Expression.ecore and Expression.genmodel in an ecore-first manner)
 */

//generate expression "http://www.esi.nl/xtext/expressions/Expression" 
import "http://www.esi.nl/xtext/expressions/Expression" 


import "http://www.esi.nl/xtext/common/lang/Base" as base
import "http://www.esi.nl/xtext/types/Types" as types

ExpressionModel returns types::TypesModel: {ExpressionModel}
    imports += Import*
    ( types += TypeDecl
    | variables += VariableDecl
    | functions += FunctionDecl
    )*
;

Variable:
    Annotations
    type = Type name = ID
;

VariableDecl:
    variable=Variable ('=' expression=Expression)?
;

FunctionDecl:
    Annotations
    'function' ('<' typeParams += GenericsTypeParam  (',' typeParams += GenericsTypeParam)* '>')? returnType = Type 
    name = ID
    ParameterizedDecl
;

/*
 * Name and parameter list of a ParameterizedDecl (see 'add extra superclasses in metamodel' below).
 * Inheriting languages can reuse it for parameterized declarations without generics or a return type.
 * References to a ParameterizedDecl (e.g. calls) should use the Arguments fragment.
 */
fragment ParameterizedDecl returns ParameterizedDecl:
    '(' (params += Parameter (',' params += Parameter)*)? ')'
;

Parameter:
    Annotations
    type = Type name = ID
;

@Override
NamedElement returns base::NamedElement:
    super::NamedElement | Variable | FunctionDecl | Parameter
;

Expression: ExpressionLevel1;

ExpressionLevel1 returns Expression:        // Left associativity
    ExpressionLevel2
    ( ({ExpressionAnd.left=current}         ("AND" | "and") right=ExpressionLevel2)  
    | ({ExpressionOr.left=current}          ("OR" | "or")   right=ExpressionLevel2) 
    )*
;

ExpressionLevel2 returns Expression:        // Left associativity
    ExpressionLevel3
    ( ({ExpressionEqual.left=current}       "=="    right=ExpressionLevel3) 
    | ({ExpressionNEqual.left=current}      "!="    right=ExpressionLevel3) 
    )*
;

ExpressionLevel3 returns Expression:        // Left associativity
    ExpressionLevel4
    ( ({ExpressionGeq.left    =current}     ">="    right=ExpressionLevel4) 
    | ({ExpressionGreater.left=current}     ">"     right=ExpressionLevel4) 
    | ({ExpressionLeq.left    =current}     "<="    right=ExpressionLevel4) 
    | ({ExpressionLess.left   =current}     "<"     right=ExpressionLevel4)
    )*
;

ExpressionLevel4 returns Expression:        // Left associativity
    ExpressionLevel5
    ( ({ExpressionAddition.left   =current} "+"     right=ExpressionLevel5) 
    | ({ExpressionSubtraction.left=current} "-"     right=ExpressionLevel5) 
    )*
;

ExpressionLevel5 returns Expression:        // Left associativity
    ExpressionLevel6
    ( ({ExpressionMultiply.left=current}    "*"     right=ExpressionLevel6) 
    | ({ExpressionDivision.left=current}    "/"     right=ExpressionLevel6)
    | ({ExpressionMaximum.left =current}    "max"   right=ExpressionLevel6)
    | ({ExpressionMinimum.left =current}    "min"   right=ExpressionLevel6)
    | ({ExpressionModulo.left  =current}    "mod"   right=ExpressionLevel6)
    )*
;

ExpressionLevel6 returns Expression:        // Right associativity
    ExpressionLevel7
    ( ({ExpressionPower.left=current}          "^"    right=ExpressionLevel6)
    | ({ExpressionNullCoalescing.left=current} "??"   right=ExpressionLevel6)
    | ({ExpressionConditional.left=current}    "?"    middle=ExpressionLevel6   ":"   right=ExpressionLevel6)
    )?
;

ExpressionLevel7 returns Expression:
    ExpressionNot | ExpressionMinus | ExpressionPlus | ExpressionLevel8
;

ExpressionNot: 
    ("NOT" | "not") sub=ExpressionLevel8
;

ExpressionMinus: 
    "-" sub=ExpressionLevel8
;

ExpressionPlus: 
    "+" sub=ExpressionLevel8
;

ExpressionLevel8 returns Expression:
    ExpressionLevel9 (({ExpressionRecordAccess.record = current} (nullSafe?='?.' | '.') field = [types::RecordField | ID]) |
                      ({ExpressionMapRW.map = current} '[' key = Expression ('->' value = Expression)? ']'))*
;

ExpressionLevel9 returns Expression:
    ExpressionBracket |
    ExpressionConstantBool |
    ExpressionConstantInt |
    ExpressionConstantReal |
    ExpressionConstantString |
    ExpressionEnumLiteral |
    ExpressionNullLiteral |
    ExpressionVariable |
    ExpressionRecord |
    ExpressionAny |
    ExpressionFunctionCall |
    ExpressionTypeAnnotated
;

ExpressionFunctionCall: 
    function = [FunctionDecl|ID] Arguments
;

/*
 * Argument list of a ParameterizedRef: a reference to a ParameterizedDecl that supplies arguments for its parameters,
 * e.g. a function call (ExpressionFunctionCall) or an activity declaration referring to an activity definition.
 * Every rule calling this fragment becomes a ParameterizedRef (like Annotations makes it Annotatable), so its
 * arguments are matched against the parameters of the referenced ParameterizedDecl (see ParameterizedDeclOverloadScope).
 * Inheriting languages can reuse it for references to their own parameterized declarations.
 * Positional arguments come first, followed by named arguments; the list may also start with a named argument.
 */
fragment Arguments returns ParameterizedRef:
    '(' (
          args += Expression (',' args += Expression)* (',' namedArgs += NamedArgument)*
        | namedArgs += NamedArgument (',' namedArgs += NamedArgument)*
    )? ')'
;

NamedArgument:
    name = ID '=' arg=Expression
;

ExpressionBracket:
    "(" sub=Expression ")"
;

ExpressionConstantBool:
    value=BOOL
;

ExpressionConstantInt:
    value=LONG
;

ExpressionConstantReal:
    value=DOUBLE
;

ExpressionConstantString:
    value = STRING
;

ExpressionEnumLiteral: 
    type = [types::EnumTypeDecl] "::" literal = [types::EnumElement] 
;

ExpressionNullLiteral:
    {ExpressionNullLiteral}
    'null'
;

ExpressionVariable: 
    variable=[Variable | ID]
;

ExpressionRecord: 
    type = [types::RecordTypeDecl] '{' fields+=Field (',' fields+=Field)* '}'
;

Field:
    recordField = [types::RecordField | ID] '=' exp = Expression
;

ExpressionAny :
    {ExpressionAny} "*"
;

ExpressionTypeAnnotated returns Expression:
    TypeAnnotation( ({ExpressionVector.typeAnnotation = current} '[' (elements += Expression (',' elements += Expression)*)? ']') |
                    ({ExpressionMap.typeAnnotation = current} '{' (pairs += Pair (',' pairs += Pair)*)? '}'))
;

TypeAnnotation :
    '<'type = Type '>'
;

Pair:
    key = Expression '->' value = Expression
;

// --- add extra superclasses in metamodel -------
ExpressionTernary returns Expression:
    {ExpressionTernary}
    left=Expression
    middle=Expression
    right=Expression
;

ConcreteExpressionTernary returns ExpressionTernary:
    {ExpressionConditional}
;

ExpressionBinary returns Expression:
    {ExpressionBinary}
;

ConcreteExpressionBinary returns ExpressionBinary:
      {ExpressionAnd}
    | {ExpressionOr}
    | {ExpressionEqual}
    | {ExpressionNEqual}
    | {ExpressionGeq}
    | {ExpressionGreater}
    | {ExpressionLeq}
    | {ExpressionLess}
    | {ExpressionAddition}
    | {ExpressionSubtraction}
    | {ExpressionMultiply}
    | {ExpressionDivision}
    | {ExpressionMaximum}
    | {ExpressionMinimum}
    | {ExpressionModulo}
    | {ExpressionPower}
    | {ExpressionNullCoalescing}
;

ExpressionUnary returns Expression:
    {ExpressionUnary}
;

ConcreteExpressionUnary returns ExpressionUnary:
      {ExpressionNot}
    | {ExpressionMinus}
    | {ExpressionPlus}
    | {ExpressionBracket}   
;
