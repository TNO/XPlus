/**
 * GRAMMAR AND MODEL STRUCTURE
 * 
 * By default, this grammar imports an external Ecore model (Base.ecore) which defines
 * the abstract syntax tree (AST) structure. The grammar rules define the concrete syntax.
 * 
 * If you modify this xtext grammar:
 *   1. Switch to the "generate base" line (uncomment it, comment out the "import" line for Base)
 *   2. Right-click: Run As > Generate Xtext Artifacts (generates new Base.ecore and Base.genmodel)
 *   3. Review the generated files in models/generated/
 *   5. Switch back to the "import" line (comment out "generate", uncomment "import")
 *   2. Right-click: Run As > Generate Xtext Artifacts again  (uses new Base.ecore and Base.genmodel in an ecore first manner)
 */
grammar nl.esi.xtext.common.lang.Base with org.eclipse.xtext.common.Terminals

//generate base "http://www.esi.nl/xtext/common/lang/Base"
import "http://www.esi.nl/xtext/common/lang/Base"
import "http://www.eclipse.org/emf/2002/Ecore" as ecore

BaseModel returns ModelContainer: {BaseModel}
    imports += Import*
    table = BaseTable?
;

BaseTable: {BaseTable}
    Annotations
    Table
;

/*
 * Abstract class for all model containers.
 * Top level container element that may transitively import zero or more existing base models.
 * In this grammar, it is extended by the class BaseModel (see above)
 */
ModelContainer: {ModelContainer}
    imports += Import*
;

Import:
    'import' importURI = STRING
;

fragment Annotations returns Annotatable:
    annotations+=Annotation*
;

Annotation: {Annotation}
    name=ANNOTATION_ID ( '(' ((params+=DefaultAnnotationParam) | (params+=AnnotationParam (',' params+=AnnotationParam)* ))? ')' )?
;

AnnotationParam: {AnnotationParam}
    name=ID '=' value = AnnotationValue
;

DefaultAnnotationParam returns AnnotationParam:
    value = AnnotationValue
;

AnnotationValue:
      {AnnotationLongValue} => value=LONG
    | {AnnotationBooleanValue} => value=BOOL
    | {AnnotationStringValue} => value=STRING
    | {AnnotationDoubleValue} => value=DOUBLE
;

fragment Table returns Table:
    header = TableRow
    rows += TableRow*
;

TableRow: {TableRow}
    cells += TABLE_CELL+ '|'
;

/*
 * Abstract class for all NamedElements
 */
NamedElement:
    Annotation | AnnotationParam
;

// === Terminals =======
BOOL returns ecore::EBoolean:
    'true' | 'false' | 'TRUE' | 'FALSE' | 'True' | 'False'
;

DOUBLE returns ecore::EDouble:
    INT (('.' INT) | (('E' | 'e') ('+'|'-')? INT) | ('.' INT ('E' | 'e') ('+'|'-')? INT))
;

LONG returns ecore::ELong:
    INT
;

/*
 * The '@' prefix is part of the terminal, so the lexer always produces a single
 * ANNOTATION_ID token (longest match). This makes annotation names agnostic of any
 * keywords defined in this or inheriting languages (e.g. @suppress, @context).
 * An optional '^' escape is supported for consistency with ID.
 * The '@' (and '^') are stripped by AnnotationIdValueConverter.
 */
terminal ANNOTATION_ID returns ecore::EString:
    '@' '^'? ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9')*
;
terminal TABLE_CELL returns ecore::EString:
    '|' ('\\' !('\n'|'\r') | !('\\'|'|'|'\n'|'\r') )+
;