module nl.esi.xtext.actions.GenerateActions

import org.eclipse.xtext.xtext.generator.*
import org.eclipse.xtext.xtext.generator.model.project.*

var rootPath = ".."
var projectName = "nl.esi.xtext.actions"
var fileName = "Actions"
var runtimeProject = "${rootPath}/${projectName}"

Workflow {

    bean = nl.esi.xplus.emf.mwe.utils.XPlusStandAloneSetup {
            scanClassPath = true
            platformUri = "${rootPath}"
            tryRegisterGenModelFile = "platform:/resource/${projectName}/model/generated/${fileName}.genmodel"
            tryRegisterEcoreFile = "platform:/resource/${projectName}/model/generated/${fileName}.ecore"
    }

    component = XtextGenerator {
        cleaner = {
            // do not clean generated
            exclude = "${fileName}.ecore"
            exclude = "${fileName}.genmodel"
        }
        configuration = {
            project = nl.esi.xplus.xtext.generator.model.project.XPlusProjectConfig {
                baseName = projectName
                rootPath = rootPath
                runtimeTest = {
                    enabled = true
                }
                eclipsePlugin = {
                    enabled = true
                }
                edit = {
                    enabled = true
                }
                createEclipseMetaData = true
            }
            code = {
                encoding = "UTF-8"
                fileHeader = "/*\n * generated by Xtext \${version}\n */"
            }
        }
        language = StandardLanguage {
            name = "${projectName}.${fileName}"
            fileExtensions = "act"

            referencedResource = "platform:/resource/nl.esi.xtext.common.lang/model/generated/Base.genmodel"
            referencedResource = "platform:/resource/nl.esi.xtext.types/model/generated/Types.genmodel"
            referencedResource = "platform:/resource/nl.esi.xtext.expressions/model/generated/Expression.genmodel"
            referencedResource = "platform:/resource/${projectName}/model/generated/${fileName}.genmodel"

            serializer = {
                generateStub = false
            }
            validator = {
                // composedCheck = "org.eclipse.xtext.validation.NamesAreUniqueValidator"
            }
            formatter = formatting.Formatter2Fragment2 {
                generateStub = true
            }
            contentAssist = nl.esi.xplus.xtext.generator.ide.contentassist.IdeContentAssistFragment2 {
                generateXtendStub = true
            }
            junitSupport = {
                junitVersion = "5"
            }
            emfGenerator = nl.esi.xplus.xtext.generator.ecore.EMFGeneratorFragment {
                generateEdit = true
                operationReflection = true
                editDirectory = "${projectName}.edit/src-gen"
                externalGenModelPath = "platform:/resource/${projectName}/model/generated/${fileName}.genmodel"
            }
        }
    }
}