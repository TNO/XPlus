            // Downcast
            map<int, A> aa = <map<int, B>>{ 1 -> b } ?? <map<int, B>>{ 1 -> b }
            map<int, A> aa = <map<int, C>>{ 1 -> c } ?? <map<int, B>>{ 1 -> b }
        ''')
