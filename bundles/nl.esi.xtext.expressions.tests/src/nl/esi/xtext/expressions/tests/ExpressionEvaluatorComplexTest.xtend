    @Test
    def void recordsAndTypes() {
        val types = '''
            enum Count { ONE TWO THREE }

            record T {
                int ti
                real tr
                bool tb
                Count te
                string[] tss
                map<int, string> ti2s
            }
        '''

        assertEval('''
            «types»
            T t = T {
                ti = 1,
                tr = 1.1,
                tb = true,
                te = Count::TWO,
                tss = <string[]> [ "Hello", "World" ],
                ti2s = <map<int, string>> { 1 -> "Hello", 2 -> "World" }
            }
        ''', '''
            «types»
            T t = T {
                ti = 1,
                tr = 1.1,
                tb = true,
                te = Count::TWO,
                tss = <string[]> [ "Hello", "World" ],
                ti2s = <map<int, string>> { 1 -> "Hello", 2 -> "World" }
            }
        ''')
    }

