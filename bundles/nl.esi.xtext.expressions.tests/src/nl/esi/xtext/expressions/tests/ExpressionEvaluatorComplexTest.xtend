        ''')
    }

    @Test
    def void complexExpression() {
        val types = '''
            record T {
                int ti
                bool tb
                int[] tv
            }
        '''

        assertEval('''
            «types»
            bool a
            bool b = not a

            T t = T {
                ti = 5,
                tb = true or ((not a) and true)
            }
        ''', '''
            «types»
            bool a
            bool b = not a

            T t = T {
                ti = (1 + 2) * 3 - 4,
                tb = (1 == 1 and 2 == 2) or (b and 3 == 3)
            }
        ''')

        assertEval('''
            «types»
            T step1 = T {
                tb = true
            }
            T step2 = T {
                tv = <int[]> [ step1.ti ]
            }
            T step3 = T {
                ti = step1.ti
            }
            T step4 = T {
                ti = step1.ti + 1
            }
        ''', '''
            «types»
            T step1 = T {
                tb = true
            }
            T step2 = T {
                tv = <int[]> [ step1.ti ]
            }
            T step3 = T {
                ti = get(step2.tv, 1 - 1)
            }
            T step4 = T {
                ti = step3.ti + 1
            }
        ''')

        assertEval('''
            «types»
            T step1
            T step2 = T {
                ti = get(step1.tv, 5)
            }
            T step3 = T {
                ti = get(step1.tv, 5) + 1
            }
        ''', '''
            «types»
            T step1
            T step2 = T {
                ti = get(step1.tv, 1 + 4)
            }
            T step3 = T {
                ti = step2.ti + 1
            }
        ''')
    }

